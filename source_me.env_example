# Copy this file to source_me.env, fill in the values, then source it in the
# shell where you run ./rhwa-lab. Keep source_me.env private (it is gitignored).

# AWS_REGION is required for create and test. It uses your existing environment
# value by default; uncomment this line to override it.
# export AWS_REGION='us-east-1'

# Defaults to pull-secret.txt in the current directory; set PULL_SECRET_FILE
# before sourcing this file to use another path.
export PULL_SECRET_FILE="${PULL_SECRET_FILE:-pull-secret.txt}"
if [[ ! -f "$PULL_SECRET_FILE" ]]; then
  printf 'Pull secret file not found: %s\n' "$PULL_SECRET_FILE" >&2
  return 1
fi
PULL_SECRET="$(cat "$PULL_SECRET_FILE")" || return 1
export PULL_SECRET

# AWS credentials also use your existing environment by default. Uncomment and
# fill these in to override access-key credentials.
# export AWS_ACCESS_KEY_ID='your-access-key-id'
# export AWS_SECRET_ACCESS_KEY='your-secret-access-key'
# export AWS_SESSION_TOKEN=''  # Also needed for temporary access-key credentials.

# Or use a configured AWS profile:
# export AWS_PROFILE='your-profile'

# Use a domain backed by a Route53 hosted zone accessible to these credentials.
export BASE_DOMAIN='example.com'
# export ROUTE53_ZONE_ID='ZXXXXXXXXXXXXX'  # Optional if the zone can be found from BASE_DOMAIN.

# The matching private key must exist at the same path without the .pub suffix.
# Use an Ed25519 key or an RSA key of at least 2048 bits.
export SSH_PUBLIC_KEY_FILE="$HOME/.ssh/id_rsa.pub"

# Optional overrides; defaults are shown.
# export CLUSTER_NAME='rhwa-lab'
# export OCP_VERSION='5.0.0-rc.1'
# export ODF_ENABLED='false'  # ODF is enabled by default.
