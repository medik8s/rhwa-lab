#!/usr/bin/env bash
# rhwa-lab - stand up / tear down a disposable "bare metal" OpenShift cluster
# on a nested-virt AWS m8i instance and test RHWA fence_redfish remediation.
#
# Usage:
#   ./rhwa-lab create     Provision everything end-to-end
#   ./rhwa-lab monitor    Live, phase-aware install progress (safe any time)
#   ./rhwa-lab test       Trigger + verify a fence_redfish remediation
#   ./rhwa-lab status     Show endpoints, credentials, uptime
#   ./rhwa-lab install-config  Print a sanitized install-config.yaml (no secrets)
#   ./rhwa-lab allow [IP]  Allow another IP (or 'all') through the firewall
#   ./rhwa-lab power <on|off|reset> <node>  Out-of-band power via ssh->virsh
#   ./rhwa-lab vms-definitions   Print node->domain/host JSON for test power control
#   ./rhwa-lab destroy    Tear everything down (incl. Route53 records)
#   ./rhwa-lab help       Show this help
#
# All inputs come from environment variables (see README.md). No config file.

set -euo pipefail

_cleanup_warning() {
  local rc=$?
  if [[ $rc -ne 0 && "${_RHWA_IN_CREATE:-}" == "yes" ]]; then
    printf '\n\033[1;31m[%s] ✗ Create failed (exit %d). AWS resources may still be running!\033[0m\n' "$(_ts)" "$rc" >&2
    printf '\033[1;31m    Run:  ./rhwa-lab destroy\033[0m\n' >&2
    printf '\033[1;31m    Cost: ~$2.45/hr while the instance is running.\033[0m\n' >&2
  fi
}
trap _cleanup_warning EXIT

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "${SELF_DIR}/lib/common.sh"
source "${SELF_DIR}/lib/state.sh"
source "${SELF_DIR}/lib/aws.sh"
source "${SELF_DIR}/lib/host.sh"
source "${SELF_DIR}/lib/vms.sh"
source "${SELF_DIR}/lib/openshift.sh"
source "${SELF_DIR}/lib/rhwa.sh"
source "${SELF_DIR}/lib/odf.sh"
source "${SELF_DIR}/lib/testfence.sh"
source "${SELF_DIR}/lib/power.sh"

usage() { sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

check_inputs() {
  require_cmds aws jq curl ssh scp tar openssl
  # ROUTE53_ZONE_ID is optional: unset -> resolved from BASE_DOMAIN; may be a
  # zone id (Z...) or a domain name. See resolve_r53_zone in lib/aws.sh.
  require_env AWS_REGION PULL_SECRET
  if [[ -z "${AWS_PROFILE:-}" ]]; then
    require_env AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
  fi
}

report() {
  local pw; pw="$(cat "${CLUSTER_DIR}/kubeadmin-password" 2>/dev/null || echo '<unavailable>')"
  local spares; compute_spares
  if [[ ${#SPARE_NAME[@]} -gt 0 ]]; then
    spares=" Spare workers     : $(printf '%s ' "${SPARE_HOST[@]}")(extra available metal3-managed BMHs; provision on demand by scaling the MachineSet)"
  else
    spares=" Spare workers     : none"
  fi
  local odf=""
  if [[ "${ODF_ENABLED}" == "true" ]]; then
    odf=" ODF (external)    : StorageCluster 'ocs-external-storagecluster' -> Ceph on ${CEPH_NODE_NAME} (${CEPH_IP})
                     RBD pool '${CEPH_RBD_POOL}' (replica ${CEPH_POOL_REPLICA}, ${CEPH_OSD_COUNT}x${CEPH_OSD_DISK_GB} GB OSDs, ~${CEPH_POOL_USABLE_GB} GB usable)"
  else
    odf=" ODF (external)    : disabled (ODF_ENABLED=false)"
  fi
  cat >&2 <<EOF

$(printf '\033[1;32m')========================================================================
 RHWA lab '${CLUSTER_NAME}' is READY
========================================================================$(printf '\033[0m')
 Console : $(console_url)
 API     : https://$(api_fqdn):6443
 kubeadmin password : ${pw}
 kubeconfig         : ${KUBECONFIG_LOCAL}
${spares}
${odf}

 Use the cluster:
   export KUBECONFIG=${KUBECONFIG_LOCAL}
   ${BIN_DIR}/oc get nodes

 Test fencing:   ./rhwa-lab test
 Tear it down:   ./rhwa-lab destroy

 SECURITY: Ports are restricted to the IP that ran 'create'.
 Share access:  ./rhwa-lab allow <colleague-IP>
                ./rhwa-lab allow all
EOF
}

cmd_create() {
  _RHWA_IN_CREATE=yes
  check_inputs
  validate_ocp_version
  state_init
  log "Creating RHWA lab '${CLUSTER_NAME}' (${INSTANCE_TYPE}, OCP ${OCP_VERSION})"
  aws_preflight
  aws_import_keypair
  aws_security_group
  aws_launch_instance
  aws_dns_upsert
  host_provision
  os_host_tools
  os_render_configs
  os_build_image
  vms_define
  vms_sushy
  vms_boot
  os_wait_install
  os_local_oc
  os_wait_cluster_ready
  rhwa_setup
  os_provision_workers
  odf_setup
  record_ssh_channel
  _RHWA_IN_CREATE=
  ok "Create complete"
  report
}

cmd_monitor() {
  state_init
  [[ -n "$(state_get eip)" ]] || die "No instance recorded for '${CLUSTER_NAME}'; run create first."
  compute_nodes
  log "Monitoring install progress for '${CLUSTER_NAME}' (Ctrl-C to stop)"
  while true; do
    printf '\033[2J\033[H' >&2   # clear screen for a stable, refreshing view
    printf '\033[1;34m== %s  RHWA lab: %s ==\033[0m\n' "$(_ts)" "${CLUSTER_NAME}" >&2
    printf '\033[1;34m-- openshift-install log (tail) --\033[0m\n' >&2
    os_installer_log_tail 30
    printf '\033[1;34m-- cluster status --\033[0m\n' >&2
    if os_cluster_status_via_recovery; then
      ok "Install complete (ClusterVersion Available=True)."
      break
    else
      printf '  (API not serving yet — see installer log above)\n' >&2
    fi
    sleep 20
  done
}

cmd_test() { check_inputs; test_fence; }

# Print a sanitized install-config.yaml (no pull secret) to stdout. Uses the
# same renderer as `create`, so it matches the real config for the current
# CLUSTER_NAME/env. Does NOT require an existing cluster or PULL_SECRET.
cmd_install_config() { os_sanitized_install_config; }

cmd_allow() {
  require_cmds aws curl
  state_init
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    target="$(curl -fsS https://checkip.amazonaws.com 2>/dev/null || die "Could not detect IP.")"
    target="${target%%$'\n'*}/32"
    log "No IP specified; using your current IP: ${target}"
  elif [[ "$target" == "all" ]]; then
    target="0.0.0.0/0"
  elif [[ "$target" != */* ]]; then
    target="${target}/32"
  fi
  aws_sg_allow "$target"
}

cmd_power() {
  state_init
  [[ -n "$(state_get eip)" ]] || die "No instance for '${CLUSTER_NAME}'; run create first."
  local action="${1:-}" node="${2:-}"
  [[ -n "$action" && -n "$node" ]] || die "usage: rhwa-lab power <on|off|reset> <node-host>"
  node_power "$action" "$node"
}

cmd_vms_definitions() { state_init; emit_vms_definitions; }

cmd_destroy() {
  require_cmds aws
  state_init
  log "Destroying RHWA lab '${CLUSTER_NAME}'"
  aws_teardown          # terminating the instance removes VMs/sushy/haproxy with it
  rm -rf "$CLUSTER_DIR"
  state_wipe
  ok "Destroy complete (local state removed)"
}

cmd_status() {
  state_init
  local iid eip; iid="$(state_get instance_id)"; eip="$(state_get eip)"
  echo "Cluster        : ${CLUSTER_NAME}"
  echo "Instance       : ${iid:-<none>}"
  if [[ -n "$iid" ]]; then
    local st launch
    st="$(aws ec2 describe-instances --instance-ids "$iid" \
         --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null || echo unknown)"
    launch="$(aws ec2 describe-instances --instance-ids "$iid" \
         --query 'Reservations[0].Instances[0].LaunchTime' --output text 2>/dev/null || echo '')"
    echo "Instance state : ${st}  (launched ${launch})  [billing runs while 'running']"
  fi
  echo "Elastic IP     : ${eip:-<none>}"

  # When the cluster is installed AND its API is reachable, print the exact same
  # READY block as `create` does (endpoints + credentials) so status is a
  # one-stop reference. Otherwise fall back to diagnostic lines.
  if [[ "$(state_get cluster_installed)" == "yes" ]] \
     && curl -fskm 5 "https://$(api_fqdn):6443/healthz" >/dev/null 2>&1; then
    report
  else
    echo "Console        : $(console_url)"
    echo "API            : https://$(api_fqdn):6443"
    if [[ "$(state_get cluster_installed)" == "yes" ]]; then
      echo "API reachable  : no (VIP/haproxy/cluster may be down)"
      echo "kubeconfig     : ${KUBECONFIG_LOCAL}"
    fi
  fi
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    create)  cmd_create  "$@" ;;
    monitor) cmd_monitor "$@" ;;
    test)    cmd_test    "$@" ;;
    install-config) cmd_install_config "$@" ;;
    allow)   cmd_allow   "$@" ;;
    power)   cmd_power   "$@" ;;
    vms-definitions) cmd_vms_definitions "$@" ;;
    destroy) cmd_destroy "$@" ;;
    status)  cmd_status  "$@" ;;
    help|-h|--help) usage ;;
    *) usage; die "Unknown command: ${cmd}" ;;
  esac
}

main "$@"
